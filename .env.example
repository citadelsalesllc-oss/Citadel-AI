# Citadel AI — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://citadel:citadel_dev_password@localhost:5432/citadel_ai"

# --- Model provider ----------------------------------------------------------
# "anthropic" uses the real Claude API and requires ANTHROPIC_API_KEY.
# "mock" is deterministic and requires no key — used automatically in tests
# and as the local dev default when no key is configured.
MODEL_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
# Milliseconds to wait for a model response before aborting with
# ModelProviderError. Optional — defaults to 30000 (30s) if unset.
MODEL_TIMEOUT_MS="30000"

# --- Publishing (external channels) ------------------------------------------
# "mock" simulates publishing for development and never touches a real
# account. "facebook" requires FACEBOOK_PAGE_ACCESS_TOKEN and will refuse to
# run (NotConfiguredError) until it is provided — a real integration is
# future work, see integrations/social.
PUBLISH_PROVIDER="mock"
FACEBOOK_PAGE_ACCESS_TOKEN=""

# --- Reviews (Phase 5) --------------------------------------------------------
# "mock" returns deterministic fixture reviews (see
# integrations/src/reviews/fixtures.ts) for local dev/tests. "google_business"
# is a real seam that currently always throws NotConfiguredError — the OAuth
# flow and Business Profile API call are future work, see
# ARCHITECTURE.md "Future Google Business Profile integration".
REVIEW_PROVIDER="mock"
GOOGLE_BUSINESS_ACCESS_TOKEN=""
GOOGLE_BUSINESS_LOCATION_ID=""

# --- Google Business Profile (future integration) -----------------------------
GOOGLE_BUSINESS_CLIENT_ID=""
GOOGLE_BUSINESS_CLIENT_SECRET=""

# --- Web search (future integration) -----------------------------------------
WEB_SEARCH_PROVIDER="mock"
WEB_SEARCH_API_KEY=""

# --- API server ---------------------------------------------------------------
PORT=3000
NODE_ENV="development"

# --- Auth (auth-ready scaffolding; not yet enforced in MVP) -------------------
API_AUTH_TOKEN=""

# --- Citadel Command Center dashboard (Phase 6, apps/dashboard) --------------
# The dashboard is a separate static-file server; these two vars are read by
# apps/dashboard, not apps/api. DASHBOARD_PORT is the port the dashboard
# itself listens on; API_BASE_URL is where its frontend JS sends fetch()
# calls (apps/api, cross-origin — see ARCHITECTURE.md "Citadel Command
# Center dashboard"). Auth for /dashboard/* comes entirely from apps/api's
# own API_AUTH_TOKEN above — see SECURITY.md "Command Center authentication
# boundary".
DASHBOARD_PORT="3001"
API_BASE_URL="http://localhost:3000"
