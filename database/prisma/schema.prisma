// Citadel AI — Prisma schema
//
// Phase 2 replaces the Phase 1 JSON-blob client fields with a normalized
// structure: a lean core `Client` record plus one-to-many tables (Service,
// ServiceArea, Offer, Faq, MarketingNote) and one-to-one "profile" tables
// (BrandProfile, TargetAudience, SeoProfile). This is a knowledge system,
// not a generic CRM: every child table exists because a specialist agent
// needs that specific, structured slice of context (see
// database/src/client-context.ts and ARCHITECTURE.md "Client memory
// system"), not because a CRM schema conventionally has one.
//
// Tenant isolation is enforced at the repository layer (every child-record
// lookup is scoped by clientId, not just record id — see
// database/src/repositories/*), not by the schema alone; the `clientId`
// foreign key + index on every child table is what makes that scoping
// possible and fast.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("client_status")
}

model Client {
  id          String       @id @default(cuid())
  // Not in the spec's minimum field list, kept as an additive, human-friendly
  // identifier — the API and demo flows already depend on it, and it costs
  // nothing structurally.
  slug        String       @unique
  companyName String
  legalName   String?
  industry    String?
  description String?
  website     String?
  phone       String?
  email       String?
  address     String?
  city        String?
  state       String?
  zip         String?
  timezone    String?
  status      ClientStatus @default(PROSPECT)

  services        Service[]
  serviceAreas    ServiceArea[]
  brandProfile    BrandProfile?
  targetAudience  TargetAudience?
  seoProfile      SeoProfile?
  offers          Offer[]
  faqs            Faq[]
  marketingNotes  MarketingNote[]
  contentItems    ContentItem[]
  seoAudits       SeoAudit[]
  reviews         Review[]
  auditLogs       AuditLog[]
  activityLogs    ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

model Service {
  id          String  @id @default(cuid())
  client      Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  serviceName String
  description String?
  priority    Int     @default(0)
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@map("services")
}

model ServiceArea {
  id       String  @id @default(cuid())
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String
  name     String
  city     String?
  state    String?
  priority Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@map("service_areas")
}

/// One per client. Everything a Content/Brand-QA agent needs to write "in voice."
model BrandProfile {
  id       String @id @default(cuid())
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String @unique

  brandVoice                 String?
  tone                       String?
  preferredPhrases           String[] @default([])
  forbiddenPhrases           String[] @default([])
  writingStyle                String?
  emojiPolicy                 String?
  capitalizationPreferences   String?
  ctaPreferences               String?
  otherRules                  String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brand_profiles")
}

/// One per client. Who the content is written for and what argument it needs to make.
model TargetAudience {
  id       String @id @default(cuid())
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String @unique

  primaryCustomer     String?
  secondaryCustomers  String[] @default([])
  customerProblems    String[] @default([])
  buyingMotivations   String[] @default([])
  objections          String[] @default([])
  geographicTargeting String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("target_audiences")
}

/// One per client. Input for the (future) SEO Agent; also informs content generation.
model SeoProfile {
  id       String @id @default(cuid())
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String @unique

  primaryKeywords   String[] @default([])
  secondaryKeywords String[] @default([])
  targetLocations   String[] @default([])
  priorityServices  String[] @default([])
  searchIntent      String?
  // Competitor names only — a full relational Competitor entity (with its
  // own notes/history) is more structure than a knowledge system needs
  // today; add one later if a real use case needs per-competitor detail.
  competitors       String[] @default([])
  seoNotes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("seo_profiles")
}

model Offer {
  id           String    @id @default(cuid())
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId     String
  offerName    String
  description  String?
  cta          String?
  restrictions String?
  active       Boolean   @default(true)
  startDate    DateTime?
  endDate      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@map("offers")
}

model Faq {
  id       String  @id @default(cuid())
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String
  question String
  answer   String
  category String?
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@map("faqs")
}

model MarketingNote {
  id       String  @id @default(cuid())
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String
  note     String
  category String?
  priority Int     @default(0)
  source   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@map("marketing_notes")
}

enum ContentType {
  SOCIAL_POST
  INSTAGRAM_CAPTION
  GOOGLE_BUSINESS_POST
  BLOG_POST
  WEBSITE_COPY
  EMAIL
  REVIEW_RESPONSE
  CONTENT_CALENDAR
  OTHER

  @@map("content_type")
}

enum ContentStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  REVISION_REQUIRED
  // Not part of the Phase 2 spec's minimum status list, kept from Phase 1:
  // records a publish *attempt* that errored (as opposed to REJECTED, which
  // is a human editorial decision). Only reachable from APPROVED.
  FAILED

  @@map("content_status")
}

model ContentItem {
  id       String        @id @default(cuid())
  client   Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String
  type     ContentType
  status   ContentStatus @default(DRAFT)

  // Distinct from `type`: type is the kind of content, platform is where it's
  // headed (facebook/instagram/google_business/... or null for
  // platform-agnostic content like a blog post draft).
  platform String?
  title    String?
  body     String
  campaign String?
  tags     String[] @default([])
  metadata Json     @default("{}")

  createdBy String
  reviewer  String?

  approvedAt      DateTime?
  publishedAt     DateTime?
  externalId      String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions ContentVersion[]

  @@index([clientId, status])
  @@map("content_items")
}

enum VersionSource {
  AI_GENERATED
  HUMAN_EDIT

  @@map("version_source")
}

/// Append-only history of every version of a content item's body — the
/// first row (source AI_GENERATED) is written atomically with the
/// ContentItem itself (see contentRepository.create()); every human edit
/// from the Command Center dashboard (Phase 6) appends another row
/// (source HUMAN_EDIT) rather than overwriting it, so the original
/// AI-generated text stays traceable forever. Mirrors ReviewResponseVersion.
model ContentVersion {
  id            String        @id @default(cuid())
  contentItem   ContentItem   @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  contentItemId String
  body          String
  metadata      Json          @default("{}")
  source        VersionSource
  editedBy      String

  createdAt DateTime @default(now())

  @@index([contentItemId, createdAt])
  @@map("content_versions")
}

/// One row per SEO Agent run (Phase 4). `result` stores the full structured
/// SeoAuditResult (technical/on_page/local_seo/conversion/evidence/
/// recommendations) so past audits can be re-displayed or diffed without
/// re-running analysis; `overallScore` is denormalized out of `result` so
/// audits for a client/URL can be listed/compared over time with a simple
/// query instead of parsing JSON. Never stores credentials — see
/// tools/src/seo-tools.ts's seo_audit_save.
model SeoAudit {
  id       String @id @default(cuid())
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String
  url      String

  overallScore Int
  result       Json

  agentVersion  String
  modelProvider String
  modelUsed     String

  createdAt DateTime @default(now())

  @@index([clientId, url, createdAt])
  @@map("seo_audits")
}

enum ReviewSource {
  GOOGLE_BUSINESS
  MOCK
  MANUAL

  @@map("review_source")
}

enum ReviewResponseStatus {
  UNRESPONDED
  DRAFT
  APPROVED
  PUBLISHED
  REJECTED
  REVISION_REQUIRED

  @@map("review_response_status")
}

/// A customer review ingested from a ReviewProvider (Phase 5) — mock/manual
/// today, Google Business Profile later (see ARCHITECTURE.md "Review
/// Intelligence pipeline"). Deliberately minimal PII: reviewerName is the
/// only personal field, and only when the source actually provides one.
model Review {
  id       String       @id @default(cuid())
  client   Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String
  // The provider's own id for this review, plus which provider it came
  // from — together they're how review_sync stays idempotent (re-syncing
  // never creates duplicates) and how a future real provider slots in
  // without changing this schema.
  externalId String
  source     ReviewSource

  reviewerName String?
  rating       Int
  reviewText   String
  reviewDate   DateTime

  responseStatus ReviewResponseStatus @default(UNRESPONDED)
  // Current response only — every generated/revised draft is additionally
  // appended to `versions` below, so history is never overwritten.
  responseText   String?
  responseDate   DateTime?

  versions ReviewResponseVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, source, externalId])
  @@index([clientId, responseStatus])
  @@map("reviews")
}

/// Append-only history of every response draft generated for a review —
/// "do not overwrite historical versions" as a real, queryable guarantee
/// rather than just an AuditLog metadata trail (which also still records
/// each save as an event, see AuditLog below).
model ReviewResponseVersion {
  id       String @id @default(cuid())
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId String

  responseText String
  tone         String?
  cta          String?
  qaPassed     Boolean
  qaIssues     Json    @default("[]")
  createdBy    String
  // Defaults to AI_GENERATED for the historical rows written before Phase
  // 6 (every one of them WAS AI-generated, since editResponse() — the
  // first thing capable of writing HUMAN_EDIT — didn't exist yet).
  source       VersionSource @default(AI_GENERATED)

  createdAt DateTime @default(now())

  @@index([reviewId, createdAt])
  @@map("review_response_versions")
}

/// Persisted AI Activity feed (Phase 6) — the queryable counterpart to the
/// structured JSON lines apps/api/src/logger.ts writes to stdout. Every
/// generation/audit/review-task attempt (success or failure) gets a row
/// here so the Command Center dashboard's activity feed is real data, not
/// something reconstructed from logs. Same no-secrets guarantee as the
/// console logger: only ids and outcome metadata are ever stored, never
/// generated content, review text, or credentials.
model ActivityLog {
  id       String  @id @default(cuid())
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String?

  requestId       String
  agent           String
  task            String
  modelProvider   String?
  executionTimeMs Int
  success         Boolean
  errorCode       String?
  metadata        Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([createdAt])
  @@map("activity_logs")
}

model AuditLog {
  id       String  @id @default(cuid())
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String?

  actor      String
  action     String
  targetType String
  targetId   String?
  metadata   Json   @default("{}")

  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@map("audit_logs")
}
